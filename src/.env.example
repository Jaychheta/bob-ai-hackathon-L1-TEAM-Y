# PortFlow AI Environment Configuration
# Copy this file to .env and customize for your deployment

# Frontend Dev Server Configuration
PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# IBM Bob AI / watsonx.ai Integration (for RAG Telemetry Copilot)
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_ENDPOINT=https://api.ibm.com/bob/v1
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# Database Configuration (MongoDB Atlas Cloud Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portflow?retryWrites=true&w=majority
DB_NAME=portflow

